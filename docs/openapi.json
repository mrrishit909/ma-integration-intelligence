 "components": {
  "schemas": {
   "ApproveIn": {
    "properties": {
     "note": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "note"
    ],
    "title": "ApproveIn"
   },
   "DealIn": {
    "properties": {
     "external_ref": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "title": "External Ref"
     },
     "name": {
      "type": "string",
      "maxLength": 120,
      "title": "Name"
     },
     "target_name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "title": "Target Name"
     },
     "acquirer_revenue": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "title": "Acquirer Revenue"
     },
     "price": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "title": "Price"
     },
     "standalone_value": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "title": "Standalone Value"
     },
     "relatedness": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Relatedness",
      "description": "how close the two businesses are, 0 to 1"
     },
     "proposed_approach": {
      "type": "string",
      "pattern": "^(fast|staged)$",
      "title": "Proposed Approach",
      "default": "fast"
     },
     "management_case": {
      "$ref": "#/components/schemas/ManagementCase"
     }
    },
    "type": "object",
    "required": [
     "external_ref",
     "name",
     "target_name",
     "acquirer_revenue",
     "price",
     "standalone_value",
     "relatedness",
     "management_case"
    ],
    "title": "DealIn"
   },
   "DecisionIn": {
    "properties": {
     "deal_id": {
      "type": "string",
      "format": "uuid",
      "title": "Deal Id"
     },
     "scenario_id": {
      "type": "string",
      "format": "uuid",
      "title": "Scenario Id"
     },
     "decision_type": {
      "type": "string",
      "pattern": "^erp_integration_approach$",
      "title": "Decision Type",
      "default": "erp_integration_approach"
     },
     "choice": {
      "type": "string",
      "pattern": "^(fast|staged)$",
      "title": "Choice"
     },
     "rationale": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 10,
      "title": "Rationale"
     }
    },
    "type": "object",
    "required": [
     "deal_id",
     "scenario_id",
     "choice",
     "rationale"
    ],
    "title": "DecisionIn"
   },
   "Doc": {
    "properties": {
     "ref": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "title": "Ref"
     },
     "kind": {
      "type": "string",
      "pattern": "^(customer_contract|side_letter|cyber_assessment)$",
      "title": "Kind"
     },
     "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "title": "Title"
     },
     "text": {
      "type": "string",
      "maxLength": 200000,
      "minLength": 20,
      "title": "Text"
     },
     "customer": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 120
       },
       {
        "type": "null"
       }
      ],
      "title": "Customer",
      "description": "the counterparty, matched to the target's customers by name"
